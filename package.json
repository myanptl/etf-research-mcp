{
  "name": "etf-research-mcp",
  "version": "1.3.0",
  "description": "MCP server for ETF research: quotes, performance with dividends, fund comparisons, and every holding from SEC N-PORT filings, including overlap between funds",
  "keywords": [
    "mcp",
    "etf",
    "finance",
    "yahoo-finance",
    "investing",
    "model-context-protocol",
    "sec-edgar",
    "n-port",
    "etf-holdings",
    "portfolio-overlap"
  ],
  "author": "Myan Patel",
  "license": "MIT",
  "homepage": "https://github.com/myanptl/etf-research-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/myanptl/etf-research-mcp.git"
  },
  "type": "module",
  "bin": {
    "etf-research-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "mcpName": "io.github.myanptl/etf-research-mcp"
}
